{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/secrets.yaml)",
      "Read(**/.pypirc)",
      "Read(**/.npmrc)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/credentials.json)",
      "Edit(**/secrets.yaml)",
      "Edit(**/.pypirc)",
      "Edit(**/.npmrc)",
      "Bash(git stash*)",
      "Bash(git -C * stash*)",
      "Bash(sh -c *stash*)",
      "Bash(*/git stash*)",
      "Bash(env git stash*)",
      "Bash(git --no-pager stash*)",
      "Bash(GIT_DIR=* git stash*)"
    ]
  },
  "env": {
    "OTEL_LOG_ASSISTANT_RESPONSES": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/bootstrap-remote.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair enforce containment --file \"$CLAUDE_TOOL_INPUT_file_path\" --operation read"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair enforce containment --file \"$CLAUDE_TOOL_INPUT_file_path\" --operation write"
          },
          {
            "type": "command",
            "command": "bpsai-pair enforce task-edit --file \"$CLAUDE_TOOL_INPUT_file_path\" --new-content \"$CLAUDE_TOOL_INPUT_new_string$CLAUDE_TOOL_INPUT_content\""
          },
          {
            "type": "command",
            "command": "bpsai-pair enforce state-edit --file \"$CLAUDE_TOOL_INPUT_file_path\" --new-content \"$CLAUDE_TOOL_INPUT_new_string$CLAUDE_TOOL_INPUT_content\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -f .claude/hooks/base_branch_guard.py ]; then exec python3 .claude/hooks/base_branch_guard.py; fi'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -f .claude/hooks/base_branch_guard.py ]; then exec python3 .claude/hooks/base_branch_guard.py; fi'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair session check --quiet"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if [ -f .claude/hooks/command_intent_gate.py ]; then exec python3 .claude/hooks/command_intent_gate.py; fi'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair compaction snapshot save --trigger \"$CLAUDE_COMPACT_TRIGGER\" --quiet"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair session check --quiet"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair orchestrate evaluate teammate_idle --agent-id \"$CLAUDE_AGENT_ID\" --agent-type \"$CLAUDE_AGENT_TYPE\" --quiet"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair orchestrate evaluate task_completed --agent-id \"$CLAUDE_AGENT_ID\" --agent-type \"$CLAUDE_AGENT_TYPE\" --quiet"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bpsai-pair history-log --quiet"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'bpsai-pair telemetry log-failure --trigger \"$CLAUDE_STOP_REASON\" --quiet 2>/dev/null || true'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'bpsai-pair context-sync --auto 2>/dev/null || true'"
          },
          {
            "type": "command",
            "command": "sh -c 'bpsai-pair telemetry log-session-end --stop-reason \"$CLAUDE_STOP_REASON\" --quiet 2>/dev/null || true'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'bpsai-pair telemetry log-subagent-outcome --stop-reason \"$CLAUDE_STOP_REASON\" --agent-id \"$CLAUDE_AGENT_ID\" --agent-type \"$CLAUDE_AGENT_TYPE\" --quiet 2>/dev/null || true'"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "managing-task-lifecycle": "user-invocable-only",
    "planning-with-pm": "user-invocable-only",
    "running-qc": "user-invocable-only",
    "auditing-sibling-projects": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "bpsai-pair-statusline",
    "padding": 0
  }
}
